# Скопіюй цей файл у .env.local і заповни значення.
# .env.local не потрапляє на GitHub. На Vercel ці ж змінні вносяться в Settings → Environment Variables.

# Supabase → Project Settings → API (або Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Адреса сайту, з неї будуються посилання в листах
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo → SMTP & API → вкладка SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# "Login", схожий на 9a1b2c001@smtp-brevo.com
SMTP_USER=
# SMTP key (не пароль від акаунта Brevo)
SMTP_PASSWORD=
# Підтверджена в Brevo адреса відправника (Senders)
MAIL_FROM=
